{
	"name": "@le-space/invoice",
	"version": "0.1.0",
	"private": true,
	"description": "Invoices that live in your own peer-to-peer store: records, numbering, templates, PDF and payment codes.",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./*": "./src/core/*.js",
		"./i18n/*": "./src/i18n/*"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "vitest --run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"app:dev": "pnpm --filter @le-space/invoice-app dev",
		"app:build": "pnpm --filter @le-space/invoice-app build",
		"app:check": "pnpm --filter @le-space/invoice-app check",
		"app:test": "pnpm --filter @le-space/invoice-app test:unit",
		"app:e2e": "pnpm --filter @le-space/invoice-app test:e2e",
		"app:lint": "pnpm --filter @le-space/invoice-app lint"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"@pdf-lib/fontkit": "1.1.1",
		"@scure/base": "2.4.0",
		"pdf-lib": "1.17.1",
		"uqr": "0.1.3"
	},
	"devDependencies": {
		"prettier": "^3.4.2",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@10.33.0"
}
